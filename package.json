{
  "name": "poi-app",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "build:backend": "npm run build -w packages/backend",
    "build:frontend": "npm run build -w packages/frontend",
    "build": "npm run build -w packages/frontend",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "setup:storage": "npm run setup:storage -w packages/backend",
    "seed:admin": "npm run seed:admin -w packages/backend"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
