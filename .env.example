# Werte aus dem Supabase-Projekt. Diese Datei ist eine Vorlage - die echten
# Werte gehoeren in eine lokale .env (gitignored) bzw. in die
# Umgebungsvariablen des Vercel-Projekts.

# --- Backend (serverseitig, niemals ins Frontend-Bundle) -------------------

# Supabase > Project Settings > Database > Connection string > Transaction pooler.
# WICHTIG: Port 6543 (Transaction Pooler), nicht 5432. Der Direktanschluss haelt
# je Verbindung eine eigene Postgres-Session offen und ist fuer Serverless
# ungeeignet.
DATABASE_URL=postgresql://postgres.<projekt-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Auf true setzen, um die TLS-Zertifikatspruefung zur Datenbank streng zu
# erzwingen. Standard ist aus, weil die Pooler-Hostnamen je nach Region nicht
# gegen den Node-Truststore validieren. Die Verbindung ist in beiden Faellen
# verschluesselt.
# DATABASE_SSL_STRICT=true

# Supabase > Project Settings > API
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Nur noetig, wenn das Supabase-Projekt noch mit dem alten, gemeinsamen
# HS256-Geheimnis signiert (Project Settings > API > JWT Settings).
# Neuere Projekte signieren asymmetrisch, dann kann die Zeile entfallen.
# SUPABASE_JWT_SECRET=<jwt-secret>

# --- Frontend (landet im Bundle, daher nur oeffentliche Werte) -------------

VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
