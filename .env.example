# Werte aus dem Supabase-Projekt. Diese Datei ist eine Vorlage - die echten
# Werte gehoeren in eine lokale .env (gitignored) bzw. in die
# Umgebungsvariablen des Vercel-Projekts.
#
# HINWEIS: Wer die Supabase-Integration in Vercel nutzt, muss dort nichts von
# Hand nachtragen. Der Code akzeptiert die Namen, die die Integration anlegt:
#   DATABASE_URL            <- ersatzweise POSTGRES_URL
#   VITE_SUPABASE_URL       <- ersatzweise SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY  <- ersatzweise SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY
# Zu pruefen ist dort nur zweierlei: dass POSTGRES_URL auf Port 6543 zeigt und
# dass die Variablen nicht nur fuer Production, sondern auch fuer Preview
# freigegeben sind, falls Preview-Deployments genutzt werden.

# --- Backend (serverseitig, niemals ins Frontend-Bundle) -------------------

# Supabase > Project Settings > Database > Connection string > Transaction pooler.
# WICHTIG: Port 6543 (Transaction Pooler), nicht 5432. Der Direktanschluss haelt
# je Verbindung eine eigene Postgres-Session offen und ist fuer Serverless
# ungeeignet.
DATABASE_URL=postgresql://postgres.<projekt-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Auf true setzen, um die TLS-Zertifikatspruefung zur Datenbank streng zu
# erzwingen. Standard ist aus, weil die Pooler-Hostnamen je nach Region nicht
# gegen den Node-Truststore validieren. Die Verbindung ist in beiden Faellen
# verschluesselt.
# DATABASE_SSL_STRICT=true

# Supabase > Project Settings > API
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Nur noetig, wenn das Supabase-Projekt noch mit dem alten, gemeinsamen
# HS256-Geheimnis signiert (Project Settings > API > JWT Settings).
# Neuere Projekte signieren asymmetrisch, dann kann die Zeile entfallen.
# SUPABASE_JWT_SECRET=<jwt-secret>

# --- Erinnerungsmails zu Faelligkeiten -------------------------------------

# Resend > API Keys. Fehlt der Schluessel, laeuft der taegliche Auftrag zwar an,
# verschickt aber nichts und meldet das im Bericht.
RESEND_API_KEY=<resend-api-key>

# Absenderadresse. Solange keine eigene Domaene in Resend verifiziert ist, muss
# die Testdomaene stehen bleiben - eigene Adressen weist Resend sonst ab. Die
# Testdomaene liefert ausserdem nur an die Adresse des Resend-Kontos aus.
MAIL_FROM=POI-App <onboarding@resend.dev>

# Basisadresse fuer den Link in den Mails, ohne abschliessenden Schraegstrich.
APP_BASE_URL=https://<projekt>.vercel.app

# Selbst vergebenes Geheimnis fuer den taeglichen Aufruf des Versands.
# Vercel schickt es bei gesetzter Variable automatisch als
# "Authorization: Bearer <wert>" mit. Ist es nicht gesetzt, bleibt
# /api/cron/due-date-digest gesperrt - ein offener Endpunkt, der Mails
# ausloest, waere aus dem Netz beliebig oft aufrufbar.
CRON_SECRET=<beliebige-lange-zeichenkette>

# --- Frontend (landet im Bundle, daher nur oeffentliche Werte) -------------

VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
