{
  "name": "@poi-app/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./app": "./dist/app.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "setup:storage": "tsx src/scripts/setupStorage.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:templates": "tsx src/scripts/seedTemplates.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
